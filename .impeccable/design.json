      "css": ".ds-btn-dark{font-family:'Hanken Grotesk',system-ui,-apple-system,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 16px;border:0;border-radius:14px;font-size:15px;font-weight:700;cursor:pointer;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1),transform 120ms cubic-bezier(0.16,1,0.3,1);width:160px;background:var(--panel-up,#252a35);color:var(--ink,#eef0f3);} .ds-btn-dark:hover{background:#2f3542;} .ds-btn-dark:active{transform:scale(0.98);} .ds-btn-dark:focus-visible{outline:2px solid var(--gel-straw,#d8c98f);outline-offset:3px;}"
