    {
      "name": "Light Button",
      "kind": "button",
      "refersTo": "button-light",
      "description": "Primary action (Start recording, Done, Try again); always the light fill in the bottom thumb row.",
      "html": "<button class=\"ds-btn-light\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z\"/><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"/><line x1=\"12\" x2=\"12\" y1=\"19\" y2=\"22\"/></svg> Start recording</button>",
      "css": ".ds-btn-light{font-family:'Hanken Grotesk',system-ui,-apple-system,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 16px;border:0;border-radius:14px;font-size:15px;font-weight:700;cursor:pointer;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1),transform 120ms cubic-bezier(0.16,1,0.3,1);width:320px;background:var(--ink,#eef0f3);color:var(--stage,#0f1116);} .ds-btn-light:hover{background:#ffffff;} .ds-btn-light:active{transform:scale(0.98);} .ds-btn-light:focus-visible{outline:2px solid var(--gel-straw,#d8c98f);outline-offset:3px;}"
    },
    {
