      "css": ".ds-swatches{font-family:'Hanken Grotesk',system-ui,-apple-system,sans-serif;display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none;font-size:15px;} .ds-swatches li{display:inline-flex;align-items:center;gap:8px;padding:6px 12px 6px 10px;border-radius:8px;background:var(--panel,#1b1f28);color:var(--ink,#eef0f3);} .ds-chip{width:12px;height:12px;border-radius:3px;} .ds-name{font-weight:600;} .ds-word{color:var(--ink-soft,#a3aab6);}"
